# ---------------------------------------------------------------------------
# PATIENT DATA — NEVER COMMIT
# ---------------------------------------------------------------------------
# sample_ECGs/ holds real ECGs. Everything in it stays local, always.
sample_ECGs/
**/private/

# Any loose tracing that lands elsewhere in the tree. Deliberately broad:
# a false positive costs one `git add -f`, a false negative leaks PHI.
*.pdf
*.png
*.jpg
*.jpeg
*.heic
*.heif
*.tif
*.tiff
*.bmp
*.dcm
*.scp
*.edf
*.bdf
*.hea
*.dat

# Synthetic fixtures contain no patient data, but they are build artifacts —
# ~3 MB of PDFs and sample dumps reproducible with `deno task fixtures`.
test/fixtures/synthetic/

# ---------------------------------------------------------------------------
# Public reference corpora — fetched, never committed
# ---------------------------------------------------------------------------
# PTB-XL and friends are open, de-identified and CC BY 4.0, so this is not a
# PHI rule — it is a size rule. The full PTB-XL release is 1.7 GB and every byte
# is reproducible with `npm run fetch:ptbxl`. Committing a corpus also silently
# takes on its licence: PTB-XL is CC BY, but MIMIC-IV-ECG is ODbL share-alike,
# and vendoring that would put the whole repository under it.
data/

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
target/
web/wasm/
node_modules/
.vite/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.DS_Store
*.log
.vscode/
.idea/
