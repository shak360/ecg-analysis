{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    // Vite resolves .ts specifiers; the compiler only needs to allow them.
    "allowImportingTsExtensions": true
  },
  "include": ["web/src", "tools", "test", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "web/wasm", "web/vendor", "target"]
}
